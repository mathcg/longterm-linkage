\name{longtermLinkage-package}
\alias{longtermLinkage}
\alias{longtermLinkage-package}
\docType{package}
\title{Long-Term Effects from Linked Trial and Follow-Up Data}
\description{
Implements survival-analysis methods for clinical trials that are partially
linked to observational follow-up data, following Cheng et al. (2026).
}
\details{
The package provides complete-case, augmented complete-case,
non-linked-as-censored, and inverse-probability-of-linkage weighted analyses,
along with the simulation designs and synthetic PCPT example used in the paper.
}
\references{
Cheng, G., Chen, Y.-C., Unger, J. M., Till, C., and Zhao, Y.-Q. (2026).
Long-Term Effect Estimation When Combining Clinical Trial and Observational
Follow-Up Datasets. \emph{Journal of the American Statistical Association},
121(553), 492--501. \doi{10.1080/01621459.2025.2526703}.
}
